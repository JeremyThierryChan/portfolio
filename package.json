{
  "name": "my-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Six-language, time-themed portfolio for Jeremy Thierry Chan — language, trade and technology.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeremyThierryChan/portfolio.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "node scripts/build-resume-json.mjs && vite build",
    "preview": "vite preview",
    "test": "node --test tests/schedule.test.mjs tests/theme-boot.test.mjs tests/theme-pin.test.mjs tests/audience.test.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify:cascade": "node scripts/verify-cascade.mjs",
    "verify:layout": "node scripts/verify-layout.mjs",
    "smoke": "node scripts/smoke-render.mjs",
    "verify": "npm run test && npm run verify:content && npm run verify:i18n && npm run verify:contrast && npm run verify:cascade && npm run verify:layout && npm run verify:resume && npm run smoke && npm run build",
    "resume:json": "node scripts/build-resume-json.mjs",
    "verify:resume": "node scripts/build-resume-json.mjs",
    "questions": "node scripts/open-questions.mjs"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vue/server-renderer": "^3.4.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0"
  }
}
